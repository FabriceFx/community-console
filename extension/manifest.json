{
  "manifest_version": 3,
  "name": "Suivi PE - Community Console",
  "version": "1.5.0",
  "description": "Ajoute un bouton pour suivre une question dans Google Sheets depuis la Community Console.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://support.google.com/s/community/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configuration Tracker PE"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://support.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
