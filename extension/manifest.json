{
  "manifest_version": 3,
  "name": "Suivi PE - Community Console",
  "version": "1.14.0",
  "description": "Rédige avec Gemini une proposition de réponse aux fils de la Community Console, placée dans le champ de réponse sans être publiée.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://support.google.com/s/community/*",
    "https://support.google.com/*/thread/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configuration Tracker PE"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://support.google.com/s/community/*",
        "https://support.google.com/*/thread/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
